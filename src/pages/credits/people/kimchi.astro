<title>Kimchi</title>
<style>
.container {  display: grid;
  grid-template-columns: 0.5fr 0.5fr 0.5fr 0.5fr 0.5fr 0.5fr;
  grid-template-rows: 0.3fr 0.5fr 0.5fr 0.5fr 0.5fr;
  gap: 0px 0px;
  grid-auto-flow: row;
  grid-template-areas:
    "div2 div2 div2 div5 div5 div5"
    "div3 div3 div3 div4 div4 div4"
    "div3 div3 div3 div1 div1 div1"
    "div3 div3 div3 div1 div1 div1"
    "div3 div3 div3 div1 div1 div1";
}

.div4 { grid-area: div4; }

.div1 { grid-area: div1; }

.div5 { grid-area: div5; }

.div3 { grid-area: div3; }

.div2 { grid-area: div2; }


.title{
    font-size: 2rem;
    
}
.menu-c{
      background-color: rgba(25, 25, 25, 0.6);
}
@media (prefers-color-scheme: light){
    .menu-c{
      background-color: rgba(170, 168, 168, 0.6);
}
}
@media screen and (orientation:portrait){
    .menu-c{
        text-align:center;
        width: 100%;
        font-size: 24px;
    }
    .wowsee{
display:inline-block;
    }
    .title{
        font-size: 24px;
    }
.container {  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 0.2fr 0.5fr 0.2fr 0.5fr 0.5fr 0.5fr 0fr;
  gap: 0px 0px;
  grid-auto-flow: row;
  grid-template-areas:
    "div5 div5 div5"
    "div4 div4 div4"
    "div1 div1 div1"
    "div1 div1 div1"
    "div2 div2 div2"
    "div3 div3 div3"
    "div3 div3 div3";
}

.div5 { grid-area: div5; }

.div4 { grid-area: div4; }

.div1 { grid-area: div1; }

.div2 { grid-area: div2; }

.div3 { grid-area: div3; }

@media screen and (orientation:landscape){

    .wowsee{
float:right;
    }
}
</style>


  <!-- burger menu -->
  <input type="checkbox" aria-label="Toggle menu" />
  <span></span>
  <span></span>
  <span></span>

  <!-- logo -->
  <a data-astro-prefetch="load" href="/" class="menu-logo">
    <img style="width: 100%; height: 100%;" src="https://ik.imagekit.io/closesttopurple/thecagemoon.avif" alt=""/>
  </a>

  <!-- menu items -->
  <div class="menubar">
    <ul>
      <li>
        <a data-astro-prefetch="load" href="/stories">
          Stories
        </a>
      </li>
      <li>
        <a data-astro-prefetch="load" href="/series-guide/ths-guide-selection">
          Series Guide
        </a>
      </li>
      <li>
        <a data-astro-prefetch="load" href="/media">
          Media
        </a>
      </li>
      <li>
        <a data-astro-prefetch="load" href="/credits">
          Credits
        </a>
      </li>
            <li>
        <a data-astro-prefetch="load" href="https://reader.thehumanserver.org/" target="_blank" rel="noopener noreferrer">
          Reader
        </a>
      </li>
            <li>
        <a data-astro-prefetch="load" href="https://github.com/closesttopurple/THE-HUMAN-SERVER" target="_blank" rel="noopener noreferrer">

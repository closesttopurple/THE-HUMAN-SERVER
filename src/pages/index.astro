---
import TextLayout from '@layouts/TextLayout.astro';
import { SEO } from 'astro-seo';
---
<TextLayout>
</TextLayout>
<html lang="en">
  <head>
    <SEO
      title="Drakengard and NieR Translations & Lore | THE HUMAN SERVER"
      description="Archival, translation, and lore site for Drakengard and NieR."
      extend={{
        // extending the default link tags
        link: [{ rel: "icon", href: "/favicon.ico" }],
        // extending the default meta tags
      }}
    />
    <meta name="keywords" content="drakengard, nier, archival, drakenier, ths, the human server,drag-on dragoon, yoko taro, sinoalice, nier:automata, nier rein, nier reincarnation, reincarnation, dod, dod1, dod2, dod3, drakengard 2, drakengard 3"/>
<link rel="canonical" href="https://thehumanserver.org/" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
</html>
<title>THE HUMAN SERVER - Drakengard and NieR Archival & Translations</title>
<style>

@media screen and (orientation: portrait) and (prefers-color-scheme: dark)
{
     body{
    background-image: url("https://ik.imagekit.io/closesttopurple/bg-dark/ths-portrait.avif?updatedAt=1755052207102");
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    background-attachment: fixed;
     }
}
